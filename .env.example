# Optional: enables dynamic product image lookup.
# Create a Google Programmable Search Engine with image search enabled.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Optional: enables live product price enrichment.
# PriceAPI uses an async job flow, so pages still fall back to indexed prices if it is unavailable.
PRICEAPI_API_KEY=
PRICEAPI_SOURCE=amazon
PRICEAPI_COUNTRY=us

# Optional: point the Next.js API route at the deployed FastAPI backend.
# Leave empty if you want the hosted app to use the built-in Next.js scoring path.
FASTAPI_URL=
OPENBY_API_URL=

# Optional: enables database-backed cached product reports in the active app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
